{{define "interfaceCodePgx"}}
    type Querier interface {
    {{- $dbtxParam := .EmitMethodsWithDBArgument -}}
    {{- range .GoQueries}}
        {{- if and (eq .Cmd ":one") ($dbtxParam) }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, db {{if $.QualifyQueryTypes}}{{queryPkg}}.DBTX{{else}}DBTX{{end}}, {{argPair .Arg}}) ({{qualifyType .Ret.DefineType}}, error)
        {{- else if eq .Cmd ":one" }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, {{argPair .Arg}}) ({{qualifyType .Ret.DefineType}}, error)
        {{- end}}
        {{- if and (eq .Cmd ":many") ($dbtxParam) }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, db {{if $.QualifyQueryTypes}}{{queryPkg}}.DBTX{{else}}DBTX{{end}}, {{argPair .Arg}}) ([]{{qualifyType .Ret.DefineType}}, error)
        {{- else if eq .Cmd ":many" }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, {{argPair .Arg}}) ([]{{qualifyType .Ret.DefineType}}, error)
        {{- end}}
        {{- if and (eq .Cmd ":exec") ($dbtxParam) }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, db {{if $.QualifyQueryTypes}}{{queryPkg}}.DBTX{{else}}DBTX{{end}}, {{argPair .Arg}}) error
        {{- else if eq .Cmd ":exec" }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, {{argPair .Arg}}) error
        {{- end}}
        {{- if and (eq .Cmd ":execrows") ($dbtxParam) }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, db {{if $.QualifyQueryTypes}}{{queryPkg}}.DBTX{{else}}DBTX{{end}}, {{argPair .Arg}}) (int64, error)
        {{- else if eq .Cmd ":execrows" }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, {{argPair .Arg}}) (int64, error)
        {{- end}}
        {{- if and (eq .Cmd ":execresult") ($dbtxParam) }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, db {{if $.QualifyQueryTypes}}{{queryPkg}}.DBTX{{else}}DBTX{{end}}, {{argPair .Arg}}) (pgconn.CommandTag, error)
        {{- else if eq .Cmd ":execresult" }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, {{argPair .Arg}}) (pgconn.CommandTag, error)
        {{- end}}
        {{- if and (eq .Cmd ":copyfrom") ($dbtxParam) }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, db {{if $.QualifyQueryTypes}}{{queryPkg}}.DBTX{{else}}DBTX{{end}}, {{argSlicePair .Arg}}) (int64, error)
        {{- else if eq .Cmd ":copyfrom" }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, {{argSlicePair .Arg}}) (int64, error)
        {{- end}}
        {{- if and (or (eq .Cmd ":batchexec") (eq .Cmd ":batchmany") (eq .Cmd ":batchone")) ($dbtxParam) }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, db {{if $.QualifyQueryTypes}}{{queryPkg}}.DBTX{{else}}DBTX{{end}}, {{argSlicePair .Arg}}) *{{qualifyType (printf "%sBatchResults" .MethodName)}}
        {{- else if or (eq .Cmd ":batchexec") (eq .Cmd ":batchmany") (eq .Cmd ":batchone") }}
            {{range .Comments}}//{{.}}
            {{end -}}
            {{.MethodName}}(ctx context.Context, {{argSlicePair .Arg}}) *{{qualifyType (printf "%sBatchResults" .MethodName)}}
        {{- end}}

    {{- end}}
    }

    var _ Querier = (*{{qualifyType "Queries"}})(nil)
{{end}}
